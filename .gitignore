# Analysis outputs (keep scripts and key docs, exclude all generated data)
analysis/training_output/*
!analysis/training_output/*.py
!analysis/training_output/*.md
!analysis/training_output/README.md

analysis/feature_analysis/outputs/
analysis/feature_analysis/data/*.csv

# Phase diagnostics outputs (keep scripts, exclude outputs)
analysis/phase6c_diagnostics/*
!analysis/phase6c_diagnostics/*.py
!analysis/phase6c_diagnostics/*.md
!analysis/phase6c_diagnostics/README.md

analysis/phase6d_validation/*
!analysis/phase6d_validation/*.py
!analysis/phase6d_validation/*.md
!analysis/phase6d_validation/README.md

analysis/phase6e_validation/*
!analysis/phase6e_validation/*.py
!analysis/phase6e_validation/*.md
